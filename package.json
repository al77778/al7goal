{
  "name": "apryadigoal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3001",
    "dev:node": "tsx scripts/node-server.ts",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:vercel": "vite build --config vite.config.vercel.ts",
    "vercel-build": "npm run build:vercel",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test tests/api.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@freebuff/auth": "0.1.0",
    "hono": "^4.13.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.0",
    "@hono/node-server": "^2.1.11",
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "miniflare": "5.20261110.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  }
}
