# PostgreSQL untuk target Node/Vercel (Neon, Supabase, Vercel Postgres, dsb).
# Tanpa variabel ini, mode demo memakai PGlite (PostgreSQL WASM) di /tmp:
# aplikasi berjalan, tetapi data hilang saat instance server diganti.
DATABASE_URL=postgresql://user:password@host:5432/apryadigoal?sslmode=require

# Opsional: origin publik aplikasi (pemeriksaan same-origin/CSRF).
# APP_ORIGIN=https://apryadigoal.vercel.app

# Opsional: folder data PGlite saat mode demo tanpa DATABASE_URL.
# PGLITE_DIR=/tmp/apryadigoal-pg
